          "id": "t1_1",
          "equation": "x + 7 = 15",
          "answer": "8",
          "steps": [
            "x + 7 = 15",
            "The +7 is on the same side as x, so transpose it to the right side. Addition becomes subtraction: x = 15 - 7",
            "x = 8"
          ]
        },
        {
          "id": "t1_2",
          "equation": "x - 4 = 9",
          "answer": "13",
          "steps": [
