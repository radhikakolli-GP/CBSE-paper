{
  "skill": "transposition",
  "title": "Transposition Method - Solving Linear Equations",
  "intro": "The transposition method is how you solve for x by moving terms from one side of the '=' sign to the other. The rule never changes: when a term crosses the equals sign, its operation flips - a term that was added becomes subtracted (and vice versa), and a term that was multiplying becomes dividing (and vice versa). Work through the levels below in order - each one adds one more thing to juggle.",
  "rule_box": [
    "+ on one side becomes - on the other side when it crosses the '='.",
    "- on one side becomes + on the other side when it crosses the '='.",
    "× on one side becomes ÷ on the other side when it crosses the '='.",
    "÷ on one side becomes × on the other side when it crosses the '='."
  ],
  "levels": [
